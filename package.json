{
  "name": "escrutinio-publico",
  "version": "0.0.0",
  "private": true,
  "description": "Escrutinio Público: static ranking of parliamentary activity built from the Congreso de los Diputados open data.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "discover": "node pipeline/discover/run.ts",
    "pipeline": "node pipeline/run.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "web:dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --root web",
    "web:build": "ASTRO_TELEMETRY_DISABLED=1 astro build --root web",
    "web:preview": "node web/scripts/serve.ts",
    "web:audit": "node web/scripts/audit.ts",
    "web:check": "node web/scripts/browser-check.ts",
    "web:compare": "node web/scripts/compare.ts",
    "sanity": "node pipeline/sanity/run-sanity.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@astrojs/preact": "6.1.2",
    "astro": "7.4.8",
    "cheerio": "1.2.0",
    "fflate": "0.8.3",
    "preact": "11.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
