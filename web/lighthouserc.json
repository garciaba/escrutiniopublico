{
  "ci": {
    "collect": {
      "staticDistDir": "web/dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/diputados.html",
        "http://localhost/comparar.html",
        "http://localhost/diputados/cristina-abades-martinez.html",
        "http://localhost/grupos.html",
        "http://localhost/metodologia.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^((?!comparar).)*$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.95,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:best-practices": [
              "warn",
              {
                "minScore": 0.9,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:seo": [
              "warn",
              {
                "minScore": 0.9,
                "aggregationMethod": "median-run"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "comparar",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.95,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:best-practices": [
              "warn",
              {
                "minScore": 0.9,
                "aggregationMethod": "median-run"
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
