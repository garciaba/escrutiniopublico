---
import { scoring } from '../../../../config/scoring.ts';
import { site } from '../../../../config/site.ts';
import { FichaDiputado } from '../../components/Ficha.tsx';
import Base from '../../layouts/Base.astro';
import { fichaSlugs, loadFicha } from '../../lib/data.ts';
import { descripcionFicha, periodoPrincipal, resumenFicha, tituloFicha } from '../../lib/ficha.ts';

export function getStaticPaths() {
  return fichaSlugs().map((slug) => ({ params: { slug } }));
}

const ficha = loadFicha(Astro.params.slug);
const { diputado } = ficha;
const nombre = `${diputado.nombre} ${diputado.apellidos}`;
const path = `/diputados/${diputado.slug}`;
const principal = periodoPrincipal(
  ficha,
  scoring.periodos.map((periodo) => periodo.id),
);
const congreso = { '@type': 'GovernmentOrganization', name: 'Congreso de los Diputados', url: 'https://www.congreso.es/' };
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Diputados', item: new URL('/diputados', site.url).href },
        { '@type': 'ListItem', position: 2, name: nombre },
      ],
    },
    {
      '@type': 'ProfilePage',
      url: new URL(path, site.url).href,
      dateModified: ficha.fecha_calculo,
      isPartOf: { '@id': `${site.url}/#web` },
      mainEntity: {
        '@type': 'Person',
        name: nombre,
        givenName: diputado.nombre,
        familyName: diputado.apellidos,
        description: resumenFicha(ficha, principal),
        jobTitle: `Miembro del Congreso de los Diputados, ${ficha.legislatura.nombre} Legislatura`,
        memberOf: [
          { '@type': 'Organization', name: diputado.grupo.nombre },
          {
            '@type': 'Role',
            roleName: `Miembro del Congreso de los Diputados, ${ficha.legislatura.nombre} Legislatura`,
            startDate: diputado.fecha_alta,
            ...(diputado.fecha_baja ? { endDate: diputado.fecha_baja } : {}),
            memberOf: congreso,
          },
        ],
        worksFor: congreso,
        sameAs: [diputado.url_ficha_oficial],
      },
    },
  ],
};
---

<Base
  title={tituloFicha(ficha)}
  marca={false}
  description={descripcionFicha(ficha, principal)}
  path={path}
  ogType="profile"
  jsonLd={jsonLd}
>
  <div class="wrap"><FichaDiputado ficha={ficha} /></div>
  <script>
    import { boot } from '../../components/ficha-client.ts';

    boot();
  </script>
</Base>
