---
import { groups } from '../../../config/parties.ts';
import { scoring } from '../../../config/scoring.ts';
import { site } from '../../../config/site.ts';
import { RankingApp, RankingHead, RankingRows } from '../components/RankingTable.tsx';
import Base from '../layouts/Base.astro';
import { loadMeta, loadRanking } from '../lib/data.ts';
import { fechaLarga, num, porcentaje } from '../lib/format.ts';
import { aplicar, compactar, estadoInicial, filasDe } from '../lib/ranking.ts';

const ranking = loadRanking();
const meta = loadMeta();
const data = compactar(ranking, {
  colores: Object.fromEntries(groups.map((group) => [group.code, group.color])),
  nombresCortos: Object.fromEntries(scoring.dimensiones.map((d) => [d.id, d.nombreCorto])),
});
const estado = estadoInicial(data);
const filas = aplicar(filasDe(data, estado.periodo), estado, data);
const periodo = ranking.periodos.find((p) => p.id === estado.periodo);
const legislatura = ranking.legislatura;
const app = {
  data,
  ejecutado: meta.ejecutado,
  horasAviso: site.horasDatosAntiguos,
  legislaturaFinalizada: legislatura.finalizada,
};
const payload = JSON.stringify(app).replace(/</g, '\\u003c');
const conDato = data.dimensiones.length;
---

<Base title={site.lema} description={site.descripcion} path="/">
  <div class="wrap">
    <section class="portada">
      <div class="portada-cabeza">
        <div>
          <p class="antetitulo">
            {legislatura.nombre} Legislatura{legislatura.finalizada ? ' · balance final' : ''}
          </p>
          <h1 class="titular">{site.lema}</h1>
          <p class="entradilla">
            Un índice de 0 a 100 resume cuánto vota, interviene y pregunta cada diputado del Congreso, y en cuántas
            leyes aprobadas ha sido ponente. Se calcula solo con los datos abiertos de la Cámara y con una <a
              href="/metodologia">metodología pública</a
            >.
          </p>
        </div>
        <aside class="portada-mide tarjeta" aria-labelledby="mide-titulo">
          <h2 id="mide-titulo">Qué mide el índice</h2>
          <ul>
            {
              scoring.dimensiones.map((dimension) => {
                const conFuente = data.dimensiones.some((d) => d.id === dimension.id);
                return (
                  <li class={conFuente ? undefined : 'sin-dato'}>
                    <span class="nombre">{dimension.nombre}</span>
                    {!conFuente && <span class="etiqueta rayada">Sin dato oficial</span>}
                    <span class="descripcion">{dimension.descripcion}</span>
                  </li>
                );
              })
            }
          </ul>
          <p><a href="/metodologia">Cómo se calcula y qué no mide</a></p>
        </aside>
      </div>
      <dl class="portada-cifras">
        <div>
          <dt>Diputados en el ranking</dt>
          <dd>{num(periodo?.total_ranking ?? 0)}</dd>
        </div>
        <div>
          <dt>Votaciones del Pleno</dt>
          <dd>{num(meta.registros.votaciones ?? 0)}</dd>
        </div>
        <div>
          <dt>Intervenciones</dt>
          <dd>{num(meta.registros.intervenciones ?? 0)}</dd>
        </div>
        <div>
          <dt>Iniciativas</dt>
          <dd>{num(meta.registros.iniciativas ?? 0)}</dd>
        </div>
      </dl>
      {
        legislatura.finalizada && legislatura.fin && (
          <p class="aviso">
            <span>
              <strong>La {legislatura.nombre} Legislatura terminó el {fechaLarga(legislatura.fin)}.</strong> Este ranking
              recoge su balance completo. Cuando empiece la siguiente, el seguimiento volverá a ser diario.
            </span>
          </p>
        )
      }
    </section>

    <section class="ranking" aria-labelledby="ranking-titulo">
      <h2 id="ranking-titulo">Ranking de actividad parlamentaria</h2>
      <p class="seccion-nota muted">
        Actualizado el <time datetime={meta.ejecutado}>{fechaLarga(meta.ejecutado)}</time>. El índice cubre el {
          porcentaje(periodo?.cobertura ?? 0, 0)
        }: {conDato} de las {ranking.dimensiones.length} dimensiones tienen fuente oficial, y las demás no cuentan como
        cero. Las mismas cifras, sumadas por grupo parlamentario, están en <a href="/grupos">Grupos</a>.
      </p>
      <div id="ranking-controles"><RankingApp {...app} /></div>
      <noscript>
        <p class="aviso">
          <span
            >Sin JavaScript se muestra la tabla completa de la legislatura, ordenada por posición. Para buscar, filtrar
            u ordenar hace falta activarlo.</span
          >
        </p>
      </noscript>
      <div class="tabla-marco tarjeta">
        <table class="tabla" id="ranking-tabla">
          <caption class="sr">
            Ranking de actividad parlamentaria de los diputados: posición, grupo, circunscripción, índice global y
            puntuación por dimensión
          </caption>
          <thead><RankingHead data={data} estado={estado} activo={false} /></thead>
          <tbody><RankingRows data={data} filas={filas} /></tbody>
        </table>
      </div>
    </section>
  </div>
  <script type="application/json" id="ranking-data" set:html={payload} />
  <script>
    import { boot } from '../components/ranking-client.tsx';

    const cuandoLibre = window.requestIdleCallback ?? ((tarea: () => void) => window.setTimeout(tarea, 1));
    cuandoLibre(() => boot());
  </script>
</Base>
