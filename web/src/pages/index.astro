---
import { groups } from '../../../config/parties.ts';
import { scoring } from '../../../config/scoring.ts';
import { site } from '../../../config/site.ts';
import { Termino } from '../components/parts.tsx';
import { RankingApp } from '../components/RankingTable.tsx';
import Base from '../layouts/Base.astro';
import { loadMeta, loadRanking } from '../lib/data.ts';
import { fechaLarga, num, porcentaje } from '../lib/format.ts';
import { compactar, estadoInicial } from '../lib/ranking.ts';

const ranking = loadRanking();
const meta = loadMeta();
const data = compactar(ranking, {
  colores: Object.fromEntries(groups.map((group) => [group.code, group.color])),
  nombresCortos: Object.fromEntries(scoring.dimensiones.map((d) => [d.id, d.nombreCorto])),
});
const periodo = ranking.periodos.find((p) => p.id === estadoInicial(data).periodo);
const legislatura = ranking.legislatura;
const app = {
  data,
  ejecutado: meta.ejecutado,
  horasAviso: site.horasDatosAntiguos,
  legislaturaFinalizada: legislatura.finalizada,
};
const payload = JSON.stringify(app).replace(/</g, '\\u003c');
const conDato = data.dimensiones.length;
const anos = `${legislatura.inicio.slice(0, 4)}-${legislatura.fin ? legislatura.fin.slice(0, 4) : 'hoy'}`;
const descripcion = `Ranking de actividad de los ${num(periodo?.total_ranking ?? 0)} diputados del Congreso (${anos}): votaciones, intervenciones, preguntas y leyes, con datos oficiales. Busca por provincia.`;
/** The site itself, for the name search engines show next to its pages (D-040). */
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#web`,
      name: site.name,
      url: `${site.url}/`,
      inLanguage: 'es',
      description: site.descripcion,
      publisher: { '@id': `${site.url}/#org` },
    },
    {
      '@type': 'Organization',
      '@id': `${site.url}/#org`,
      name: site.name,
      url: `${site.url}/`,
      logo: `${site.url}/apple-touch-icon.png`,
      sameAs: [site.repositoryUrl],
    },
  ],
};
---

<Base title="Ranking de actividad de los diputados del Congreso" description={descripcion} path="/" jsonLd={jsonLd}>
  <div class="wrap">
    <section class="portada">
      <h1 class="titular">Ranking de actividad de los diputados</h1>
      <p class="entradilla">
        Cuánto vota, interviene, pregunta y legisla cada diputado, en un índice de 0 a 100 hecho con datos oficiales del
        Congreso. {legislatura.nombre} Legislatura{legislatura.finalizada ? ', balance final' : ''}.
      </p>
      <details class="plegable">
        <summary>Qué mide el índice</summary>
        <div class="plegable-cuerpo">
          <ul class="mide">
            {
              scoring.dimensiones.map((dimension) => {
                const conFuente = data.dimensiones.some((d) => d.id === dimension.id);
                return (
                  <li class={conFuente ? undefined : 'sin-dato'}>
                    <span class="nombre">{dimension.nombre}</span>
                    {!conFuente && <span class="etiqueta rayada">Sin dato oficial</span>}
                    <span class="descripcion">{dimension.descripcion}</span>
                  </li>
                );
              })
            }
          </ul>
          <p>
            <Termino id="cobertura">Cobertura</Termino> del {porcentaje(periodo?.cobertura ?? 0, 0)}: {conDato} de las {ranking.dimensiones.length} dimensiones
            tienen fuente oficial, y la que falta no cuenta como cero. Mide cantidad, no calidad.
            <a href="/metodologia">Metodología</a>
          </p>
        </div>
      </details>
    </section>

    <section class="ranking" aria-labelledby="ranking-titulo">
      <h2 id="ranking-titulo" class="sr">Ranking de actividad parlamentaria</h2>
      <div id="ranking-app"><RankingApp {...app} /></div>
      <noscript>
        <p class="aviso">
          <span
            >Sin JavaScript se ven los diez primeros. Todos están en la <a href="/diputados">lista completa</a>.</span
          >
        </p>
      </noscript>
      <p class="ranking-pie muted">
        Datos del <time datetime={meta.ejecutado}>{fechaLarga(meta.ejecutado)}</time>{' · '}<a href="/diputados"
          >Lista completa</a
        >{' · '}<a href="/grupos">Por grupos</a>
      </p>
    </section>
  </div>
  <script type="application/json" id="ranking-data" set:html={payload} />
  <script>
    import { boot } from '../components/ranking-client.tsx';

    const cuandoLibre = window.requestIdleCallback ?? ((tarea: () => void) => window.setTimeout(tarea, 1));
    cuandoLibre(() => boot());
  </script>
</Base>
